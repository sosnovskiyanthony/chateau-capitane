# Copy to .env.local for development; set the same variables in the host's dashboard for production.

# Resend (https://resend.com) delivers staff notifications via the worker. Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender shown on enquiry emails. Until the site's domain is verified in Resend,
# use its test sender, which only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL="Château Capitaine <onboarding@resend.dev>"

# Optional. Defaults to the restaurant's address in src/lib/data/site.ts.
# While using the test sender, set this to the Resend account owner's email.
CONTACT_TO_EMAIL=

# Inquiry storage (required by the contact form since B03b). Company-owned Supabase project.
# Server-only secret key; never use NEXT_PUBLIC_ and never put credentials in Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Notification worker, scheduled in vercel.json. Vercel Cron sends it as a Bearer token.
# Random, at least 16 characters; set in the host's secret settings.
CRON_SECRET=

# Resend delivery webhook (/api/webhooks/resend). Signing secret from the webhook's
# details page in Resend, starting with whsec_. Server-only.
RESEND_WEBHOOK_SECRET=
